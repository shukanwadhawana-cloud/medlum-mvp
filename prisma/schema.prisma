// MedLum — PostgreSQL schema (Phase C clinical encounters)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  clinicName   String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patients       Patient[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  encounters     Encounter[]
  labOrders      LabOrder[]
  auditLogs      AuditLog[]
}

model Patient {
  id        String   @id @default(cuid())
  doctorId  String
  name      String
  age       Int
  gender    String
  phone     String
  bp        String   @default("")
  allergies String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  encounters     Encounter[]
  labOrders      LabOrder[]

  @@index([doctorId])
}

model Appointment {
  id          String   @id @default(cuid())
  doctorId    String
  patientId   String
  patientName String
  date        String
  time        String
  type        String
  status      String   @default("Scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounters Encounter[]

  @@index([doctorId])
  @@index([patientId])
}

model Encounter {
  id             String   @id @default(cuid())
  doctorId       String
  patientId      String
  appointmentId  String?
  date           String
  chiefComplaint String   @default("")
  clinicalNotes  String   @default("")
  diagnosis      String   @default("")
  assessment     String   @default("")
  plan           String   @default("")
  followUpDate   String?
  bp             String   @default("")
  pulse          String   @default("")
  temperature    String   @default("")
  spo2           String   @default("")
  weight         String   @default("")
  height         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  labOrders     LabOrder[]

  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentId])
}

model Prescription {
  id          String   @id @default(cuid())
  doctorId    String
  patientId   String
  patientName String
  encounterId String?
  medicines   String
  advice      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor    Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([patientId])
  @@index([encounterId])
}

model Invoice {
  id          String   @id @default(cuid())
  doctorId    String
  patientId   String
  patientName String
  amount      Float
  status      String   @default("Pending")
  note        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model LabOrder {
  id          String    @id @default(cuid())
  doctorId    String
  patientId   String
  encounterId String?
  patientName String
  testName    String
  category    String    @default("Laboratory")
  status      String    @default("Ordered")
  result      String    @default("")
  notes       String    @default("")
  orderedAt   DateTime  @default(now())
  resultedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  doctorId  String?
  action    String
  entity    String
  entityId  String?
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([createdAt])
}
