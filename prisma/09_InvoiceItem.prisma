model InvoiceItem {
  id String @id @default(cuid())
  invoiceId String
  description String
  category String @default("Service")
  code String @default("")
  quantity Float @default(1)
  unitPrice Float
  esicRate Float?
  billedRate Float?
  amount Float
  tariffVersionId String @default("")
  tariffItemId String @default("")
  snapshotJson String @default("{}")
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade)
  @@index([invoiceId])
  @@index([tariffVersionId])
  @@index([code])
}
