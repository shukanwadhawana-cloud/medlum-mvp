model DiagnosticOrder {
  id String @id @default(cuid())
  doctorId String
  patientId String
  encounterId String?
  patientName String
  studyName String
  modality String @default("Other")
  bodyPart String @default("")
  indication String @default("")
  status String @default("Ordered")
  findings String @default("")
  impression String @default("")
  notes String @default("")
  orderedAt DateTime @default(now())
  performedAt DateTime?
  reportedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields:[doctorId],references:[id],onDelete:Restrict)
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  encounter Encounter? @relation(fields:[encounterId],references:[id],onDelete:SetNull)
  @@index([doctorId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status])
  @@index([modality])
}
