// MedLum - PostgreSQL schema (clinical encounters, labs, pharmacy, diagnostics, clinic sharing, revenue, blood bank and insurance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-file schema: remaining models in prisma/*.prisma (Prisma 6 merges all .prisma files in this directory)
