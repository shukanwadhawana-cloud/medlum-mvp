{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MedLum",
  "version": "0.2.1",
  "identifier": "com.medlum.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop-web"
  },
  "app": {
    "windows": [
      {
        "title": "MedLum",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Medical",
    "shortDescription": "MedLum clinical operations platform",
    "longDescription": "MedLum clinical operations and telemedicine platform.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
