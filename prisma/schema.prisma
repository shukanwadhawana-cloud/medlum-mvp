// MedLum - PostgreSQL schema (clinical encounters, labs, pharmacy, diagnostics, clinic sharing, revenue, blood bank and insurance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  logoUrl   String   @default("")
  website   String   @default("")
  invoiceFooter String @default("")
  registrationNo String @default("")
  ekaHipId  String   @default("")
  ekaHipCode String  @default("")
  ekaOnboardedAt DateTime?
  isActive  Boolean  @default(true)
  deactivatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ClinicMember[]
  patients  Patient[]
  invoices  Invoice[]
  bloodInventory BloodInventory[]
  bloodDonors BloodDonor[]
  bloodRequests BloodRequest[]
  insuranceProviders InsuranceProvider[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims InsuranceClaim[]
  portalAccounts PatientPortalAccount[]
  otpChallenges OtpChallenge[]
  tariffVersions TariffVersion[]
  labTemplates LabTemplate[]
  abdmConsents AbdmConsent[]
  abdmCareContexts AbdmCareContext[]
  abdmEvents AbdmEvent[]
  emergencyCases EmergencyCase[]
  @@index([name])
  @@index([isActive])
  @@index([ekaHipId])
}

model ClinicMember {
  id        String   @id @default(cuid())
  clinicId  String
  doctorId  String
  role      String   @default("DOCTOR")
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@unique([clinicId, doctorId])
  @@index([doctorId])
  @@index([clinicId, isActive])
}

model Doctor {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  phone         String   @default("")
  specialty     String   @default("")
  registrationNo String  @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   ClinicMember[]
  patients      Patient[]
  encounters    Encounter[]
  appointments  Appointment[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  diagnosticOrders DiagnosticOrder[]
  invoices      Invoice[]
  payments      Payment[]
  pharmacyItems PharmacyItem[]
  dispensings   Dispensing[]
  auditLogs     AuditLog[]
  emergencyCases EmergencyCase[]
  @@index([email])
}

model Patient {
  id            String    @id @default(cuid())
  clinicId      String
  doctorId      String?
  name          String
  phone         String    @default("")
  email         String    @default("")
  dateOfBirth   DateTime?
  gender        String    @default("")
  address       String    @default("")
  bloodGroup    String    @default("")
  allergies     String    @default("")
  notes         String    @default("")
  status        String    @default("ACTIVE")
  abhaNumber    String    @default("")
  abhaAddress   String    @default("")
  abhaStatus    String    @default("NONE")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor        Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  encounters    Encounter[]
  appointments  Appointment[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  diagnosticOrders DiagnosticOrder[]
  invoices      Invoice[]
  payments      Payment[]
  dispensings   Dispensing[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims InsuranceClaim[]
  portalAccounts PatientPortalAccount[]
  emergencyCases EmergencyCase[]
  abdmConsents  AbdmConsent[]
  abdmCareContexts AbdmCareContext[]
  @@index([clinicId])
  @@index([doctorId])
  @@index([phone])
  @@index([name])
  @@index([status])
  @@index([abhaNumber])
  @@index([deletedAt])
}

model Encounter {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  type        String   @default("OPD")
  chiefComplaint String @default("")
  diagnosis   String   @default("")
  notes       String   @default("")
  vitals      String   @default("{}")
  status      String   @default("OPEN")
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  @@index([patientId])
  @@index([doctorId])
  @@index([startedAt])
}

model Appointment {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  scheduledAt DateTime
  durationMin Int      @default(15)
  status      String   @default("SCHEDULED")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
}

model Prescription {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  encounterId String?
  medications String   @default("[]")
  notes       String   @default("")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  dispensings Dispensing[]
  @@index([patientId])
  @@index([doctorId])
}

model LabOrder {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  encounterId String?
  tests       String   @default("[]")
  status      String   @default("ORDERED")
  results     String   @default("")
  orderedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model DiagnosticOrder {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  encounterId String?
  modality    String   @default("")
  study       String   @default("")
  status      String   @default("ORDERED")
  report      String   @default("")
  orderedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model PharmacyItem {
  id            String    @id @default(cuid())
  doctorId      String
  name          String
  genericName   String    @default("")
  strength      String    @default("")
  form          String    @default("")
  quantity      Int       @default(0)
  reorderLevel  Int       @default(10)
  unitPrice     Float     @default(0)
  batchNumber   String    @default("")
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dispensings   Dispensing[]
  @@index([doctorId])
  @@index([name])
}

model Dispensing {
  id              String   @id @default(cuid())
  patientId       String
  doctorId        String
  prescriptionId  String?
  pharmacyItemId  String?
  quantity        Int      @default(1)
  notes           String   @default("")
  dispensedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  pharmacyItem    PharmacyItem? @relation(fields: [pharmacyItemId], references: [id], onDelete: SetNull)
  @@index([patientId])
  @@index([doctorId])
}

model Invoice {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  clinicId    String?
  invoiceNo   String   @default("")
  items       String   @default("[]")
  amount      Float    @default(0)
  total       Float    @default(0)
  tax         Float    @default(0)
  discount    Float    @default(0)
  status      String   @default("DRAFT")
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  payments    Payment[]
  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id          String   @id @default(cuid())
  patientId   String
  doctorId    String
  invoiceId   String?
  amount      Float
  method      String   @default("CASH")
  reference   String   @default("")
  paidAt      DateTime @default(now())
  notes       String   @default("")
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  @@index([patientId])
  @@index([doctorId])
  @@index([invoiceId])
  @@index([paidAt])
}

model BloodInventory {
  id              String    @id @default(cuid())
  clinicId        String
  bloodGroup      String
  component       String    @default("Whole Blood")
  unitsAvailable  Int       @default(0)
  status          String    @default("AVAILABLE")
  expiryDate      DateTime?
  batchNumber     String    @default("")
  donorId         String?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@index([clinicId])
  @@index([bloodGroup])
  @@index([status])
  @@index([expiryDate])
}

model BloodDonor {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  phone       String   @default("")
  bloodGroup  String
  lastDonation DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@index([clinicId])
  @@index([bloodGroup])
}

model BloodRequest {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String?
  bloodGroup  String
  component   String   @default("Whole Blood")
  units       Int      @default(1)
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  fulfilledAt DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@index([clinicId])
  @@index([status])
}

model InsuranceProvider {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  code        String   @default("")
  contact     String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  policies    InsurancePolicy[]
  claims      InsuranceClaim[]
  @@index([clinicId])
}

model InsurancePolicy {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  providerId  String
  policyNo    String
  coverage    String   @default("")
  validFrom   DateTime?
  validTo     DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider    InsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  claims      InsuranceClaim[]
  @@index([clinicId])
  @@index([patientId])
  @@index([providerId])
}

model InsuranceClaim {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  providerId  String
  policyId    String?
  claimNo     String   @default("")
  amount      Float    @default(0)
  status      String   @default("REQUESTED")
  submittedAt DateTime?
  settledAt   DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider    InsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  policy      InsurancePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  doctorId  String
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  meta      String   @default("")
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  @@index([doctorId])
  @@index([action])
  @@index([createdAt])
}

model PatientPortalAccount {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  phone       String
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@unique([clinicId, phone])
  @@index([patientId])
}

model OtpChallenge {
  id          String   @id @default(cuid())
  clinicId    String?
  phone       String
  codeHash    String
  purpose     String   @default("LOGIN")
  attempts    Int      @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  @@index([phone])
  @@index([expiresAt])
}

model TariffVersion {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  items       String   @default("[]")
  isActive    Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@index([clinicId])
}

model LabTemplate {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  tests       String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@index([clinicId])
}

model AbdmConsent {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String?
  consentId       String   @unique
  status          String   @default("REQUESTED")
  purpose         String   @default("")
  hiTypes         String   @default("[]")
  permissionFrom  DateTime?
  permissionTo    DateTime?
  rawPayload      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

model AbdmCareContext {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String?
  careContextRef  String
  display         String   @default("")
  hiType          String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  @@index([clinicId])
  @@index([patientId])
  @@index([careContextRef])
}

model AbdmEvent {
  id          String   @id @default(cuid())
  clinicId    String
  eventType   String
  payload     String   @default("")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@index([clinicId])
  @@index([eventType])
  @@index([processed])
}

model EmergencyCase {
  id                String    @id @default(cuid())
  clinicId          String
  patientId         String?
  doctorId          String
  arrivalMode       String    @default("Walk-in")
  ambulanceProvider String    @default("")
  ambulanceNumber   String    @default("")
  arrivalTime       DateTime  @default(now())
  triageLevel       String    @default("Urgent")
  chiefComplaint    String    @default("")
  vitals            String    @default("{}")
  allergies         String    @default("")
  status            String    @default("Open")
  disposition       String    @default("")
  notes             String    @default("")
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient           Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctor            Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([arrivalTime])
}
