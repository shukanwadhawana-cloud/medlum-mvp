# Database
DATABASE_URL="postgresql://user:password@host:5432/medlum"

# Session
SESSION_SECRET="generate-a-long-random-string"

# Public app URL (used for callbacks, webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay (optional for local)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Telegram Bot OTP for privileged hospital logins (Owner/Admin/Manager)
# Create a bot with @BotFather. Never commit real tokens.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Secret token Telegram sends in x-telegram-bot-api-secret-token header
TELEGRAM_WEBHOOK_SECRET=""

# Canonical public URL (Render production)
MEDLUM_APP_URL="https://medlum-mvp.onrender.com"

# EKA / ABDM (optional — required only for live ABDM flows)
EKA_BASE_URL=""
EKA_CLIENT_ID=""
EKA_CLIENT_SECRET=""
EKA_API_KEY=""
EKA_PT_ID=""
EKA_HIP_ID=""
