model Encounter {
  id String @id @default(cuid())
  doctorId String
  patientId String
  appointmentId String?
  date String
  chiefComplaint String @default("")
  clinicalNotes String @default("")
  diagnosis String @default("")
  assessment String @default("")
  plan String @default("")
  followUpDate String?
  bp String @default("")
  pulse String @default("")
  temperature String @default("")
  spo2 String @default("")
  weight String @default("")
  height String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields:[doctorId],references:[id],onDelete:Restrict)
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull)
  prescriptions Prescription[]
  labOrders LabOrder[]
  diagnosticOrders DiagnosticOrder[]
  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentId])
}
