# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medlum?sslmode=require"

# Session signing secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Global MedLum Platform Owner — server-side only; never expose or commit real values.
MEDLUM_PLATFORM_OWNER_EMAIL="founder@example.com"
MEDLUM_PLATFORM_OWNER_PASSWORD="use-a-strong-12-plus-character-secret"
MEDLUM_PLATFORM_OWNER_NAME="MedLum Founder"
PLATFORM_SESSION_SECRET="change-me-to-a-different-long-random-secret-at-least-32-chars"
MEDLUM_PLATFORM_BOOTSTRAP_SECRET="change-me-to-a-long-random-bootstrap-secret"
MEDLUM_APP_URL="https://medlum.app"

# Optional PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

VIDEO_PROVIDER="jitsi"
VIDEO_BASE_URL="https://meet.jit.si"

# Eka Care ABDM Connect — server-side only
EKA_BASE_URL="https://api.eka.care"
EKA_CLIENT_ID=""
EKA_CLIENT_SECRET=""
EKA_API_KEY=""
EKA_USER_TOKEN=""
EKA_PT_ID=""
EKA_HIP_ID=""

# Razorpay — server-side only; never expose the secret to the browser
# Start with Razorpay Test Mode for the pilot.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Razorpay recurring subscription Plan IDs. Create matching monthly/yearly plans in Razorpay Test Mode.
RAZORPAY_PLAN_PROFESSIONAL_MONTHLY="plan_..."
RAZORPAY_PLAN_PROFESSIONAL_YEARLY="plan_..."
RAZORPAY_PLAN_CLINIC_PLUS_MONTHLY="plan_..."
RAZORPAY_PLAN_CLINIC_PLUS_YEARLY="plan_..."
