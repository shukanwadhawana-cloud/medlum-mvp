# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medlum?sslmode=require"

# Session signing secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Platform founder bootstrap — set only in the deployment environment, never commit the real value
# Use a long random value, call POST /api/platform with action=bootstrap once, then rotate/remove it.
MEDLUM_PLATFORM_BOOTSTRAP_SECRET="change-me-to-a-long-random-bootstrap-secret"

# Public canonical URL used for metadata, sitemap, robots, and social previews
MEDLUM_APP_URL="https://medlum.app"

# Optional PostHog analytics — only the public project key belongs here; never put private API secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Video provider — jitsi uses the provider-neutral video adapter; external disables automatic room creation
VIDEO_PROVIDER="jitsi"
VIDEO_BASE_URL="https://meet.jit.si"

# Eka Care ABDM Connect — server-side only; never expose these in client code
EKA_BASE_URL="https://api.eka.care"
EKA_CLIENT_ID=""
EKA_CLIENT_SECRET=""
EKA_API_KEY=""
EKA_USER_TOKEN=""
EKA_PT_ID=""
EKA_HIP_ID=""

# Razorpay — server-side only; never commit real credentials or expose the secret to the browser
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
# Configure after creating the Razorpay webhook in Dashboard
RAZORPAY_WEBHOOK_SECRET=""
