# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medlum?sslmode=require"

# Session signing secret — use a long random string in production
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Video provider — jitsi uses the provider-neutral video adapter; external disables automatic room creation
VIDEO_PROVIDER="jitsi"
VIDEO_BASE_URL="https://meet.jit.si"

# Eka Care ABDM Connect — server-side only; never expose these in client code
EKA_BASE_URL="https://api.eka.care"
EKA_CLIENT_ID=""
EKA_CLIENT_SECRET=""
EKA_API_KEY=""
EKA_USER_TOKEN=""
EKA_PT_ID=""
EKA_HIP_ID=""
