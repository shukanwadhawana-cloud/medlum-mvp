model Invoice {
  id String @id @default(cuid())
  doctorId String
  patientId String
  patientName String
  clinicId String?
  amount Float
  subtotal Float?
  discount Float @default(0)
  tax Float @default(0)
  total Float?
  status String @default("Pending")
  invoiceNumber String @default("")
  tariffVersionId String @default("")
  tariffVersionName String @default("")
  note String @default("")
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor Doctor @relation(fields:[doctorId],references:[id],onDelete:Restrict)
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  clinic Clinic? @relation(fields:[clinicId],references:[id],onDelete:Restrict)
  items InvoiceItem[]
  payments Payment[]
  insuranceClaims InsuranceClaim[]
  @@index([doctorId])
  @@index([patientId])
  @@index([clinicId])
}
