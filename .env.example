# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medlum?sslmode=require"

# Session signing secret — required in production; use a long random string (>= 32 chars)
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Production doctor self-signup is disabled unless explicitly enabled (fail closed).
# ALLOW_PUBLIC_SIGNUP="true"
# Optional shared invite code required when public signup is enabled:
# SIGNUP_INVITE_CODE=""

# Video provider — jitsi uses the provider-neutral video adapter; external disables automatic room creation
VIDEO_PROVIDER="jitsi"
VIDEO_BASE_URL="https://meet.jit.si"

# Eka Care ABDM Connect — server-side only; never expose these in client code
EKA_BASE_URL="https://api.eka.care"
EKA_CLIENT_ID=""
EKA_CLIENT_SECRET=""
EKA_API_KEY=""
EKA_USER_TOKEN=""
EKA_PT_ID=""
EKA_HIP_ID=""

# Public app URL (used for Razorpay payment-link callback_url). On Render set to https://medlum-mvp.onrender.com
# MEDLUM_APP_URL="https://medlum-mvp.onrender.com"

# Razorpay Test Mode credentials (server-only; never NEXT_PUBLIC_*)
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# RAZORPAY_WEBHOOK_SECRET="..."

# Gmail SMTP OTP delivery for privileged hospital logins
# Use a Google App Password for the Gmail account used to send MedLum OTPs.
# Never commit the real password to GitHub.
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
# Optional; defaults to GMAIL_SMTP_USER.
GMAIL_SMTP_FROM=""
