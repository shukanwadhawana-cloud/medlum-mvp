model InsuranceClaim {
  id String @id @default(cuid())
  clinicId String
  patientId String
  policyId String
  invoiceId String?
  claimNumber String @default("")
  preauthNumber String @default("")
  claimType String @default("OPD")
  status String @default("Draft")
  requestedAmount Decimal @db.Decimal(12,2)
  approvedAmount Decimal @db.Decimal(12,2)
  settledAmount Decimal @db.Decimal(12,2)
  submittedAt DateTime?
  approvedAt DateTime?
  settledAt DateTime?
  rejectionReason String @default("")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict)
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  policy InsurancePolicy @relation(fields:[policyId],references:[id],onDelete:Cascade)
  invoice Invoice? @relation(fields:[invoiceId],references:[id],onDelete:SetNull)
  @@index([clinicId])
  @@index([patientId])
  @@index([policyId])
  @@index([invoiceId])
  @@index([status])
}
