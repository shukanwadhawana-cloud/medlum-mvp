model BloodInventory {
  id String @id @default(cuid())
  clinicId String
  bloodGroup String
  component String
  unitsAvailable Int @default(0)
  unitsReserved Int @default(0)
  batchNumber String @default("")
  expiryDate DateTime?
  storageLocation String @default("")
  status String @default("Available")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict)
  requests BloodRequest[]
  @@index([clinicId])
  @@index([bloodGroup])
  @@index([component])
  @@index([expiryDate])
  @@index([status])
}
