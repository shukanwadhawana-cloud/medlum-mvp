model EmergencyCase {
  id                String    @id @default(cuid())
  clinicId          String
  patientId         String?
  doctorId          String
  arrivalMode       String    @default("Walk-in")
  ambulanceProvider String    @default("")
  ambulanceNumber   String    @default("")
  arrivalTime       DateTime  @default(now())
  triageLevel       String    @default("Urgent")
  chiefComplaint    String    @default("")
  vitals            String    @default("{}")
  allergies         String    @default("")
  status            String    @default("Open")
  disposition       String    @default("")
  notes             String    @default("")
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient           Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctor            Doctor    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([arrivalTime])
}
